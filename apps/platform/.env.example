# URL base de la API (SAMI_BACK)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# URL del sitio comercial (apps/landing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: Google Maps JavaScript API (restringida por dominio). Sin ella se muestra un mapa simplificado.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Número que se muestra para emergencias vitales
NEXT_PUBLIC_EMERGENCY_PHONE=123
